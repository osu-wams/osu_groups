{
    "name": "osu-wams/osu_groups",
    "description": "Drupal Module for OSU Groups",
    "minimum-stability": "stable",
    "license": "GPL-2.0-or-later",
    "type": "drupal-custom-module",
    "authors": [
        {
            "name": "Matthew Brabham",
            "email": "matthew.brabham@oregonstate.edu"
        }
    ],
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    },
    "require": {
        "drupal/group": "^2.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "squizlabs/php_codesniffer": "^4.0",
        "drupal/coder": "^9.0",
        "friendsoftwig/twigcs": "^6.6",
        "drupol/phpcsfixer-configs-drupal": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "twigcs": "twigcs --twig-version=2"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": false,
            "symfony/runtime": false
        }
    }
}
